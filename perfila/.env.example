# Banco local: `docker compose up -d db` na raiz do repositorio.
DATABASE_URL="postgres://dev:dev@localhost:5439/valmer_dev"

# Narrativa do relatorio (src/lib/relatorio/gerar.ts).
ANTHROPIC_API_KEY=""

# Sessao (src/lib/auth/config.ts). Um por ambiente: `openssl rand -base64 32`.
# Sem ele o `next build` quebra na coleta de paginas, e nao so em execucao.
BETTER_AUTH_SECRET=""
# A unica com fallback silencioso: sem ela a biblioteca assume localhost, e o
# cookie de sessao sai sem a flag Secure num site HTTPS.
BETTER_AUTH_URL="http://localhost:3000"

# Armazenamento de arquivo (relatorio, capa de curso, video, foto).
# A aplicacao usa a CONTA DE SERVICO limitada ao bucket, nunca o root do MinIO:
# root em variavel de app significa que qualquer vazamento de ambiente entrega
# o armazenamento inteiro dos dois ambientes.
MINIO_ENDPOINT=""
MINIO_BUCKET=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
